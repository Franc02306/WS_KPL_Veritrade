    <UserSecretsId>dotnet-Veritrade_Service-6a4878f3-4c66-41d6-bd87-f040bd4139ab</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Queries\DeleteExporterPeriod.sql" />
    <None Remove="Queries\DeleteImporterPeriod.sql" />
    <None Remove="Queries\InsertExporter.sql" />
    <None Remove="Queries\InsertImporter.sql" />
